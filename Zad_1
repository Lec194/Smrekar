#include <iostream>
#include <cmath>
#include <cstdio>
using namespace std;

int main()
{
    double a,b;

    printf("Unesi prvi broj = ");
    scanf("%lf",&a);

    printf("Unesi drugi broj  = ");
    scanf("%lf",&b);

    double zbroj=a+b;
    double razlika=a-b;
    double umnozak=a*b;
    double kolicnik=a/b;




    cout<<"Zbroj je: "<<zbroj<<endl;
    cout<<"Razlika je: "<<razlika<<endl;
    cout<<"Umnozak je: "<<umnozak<<endl;
    cout<<"Kolicnik je: "<<kolicnik<<endl;







    return 0;
}
